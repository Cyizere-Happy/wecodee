# Use a random secret of at least 32 characters. Never commit your actual secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Use a persistent disk for the SQLite file.
AUTH_DB_PATH=.wecodee/auth.sqlite
# Use smtp:// for local SMTP or a STARTTLS relay and smtps:// for implicit TLS.
AUTH_SMTP_URL=
AUTH_MAIL_FROM=

# Comma-separated emails that get the admin role in the workspace.
WECODEE_ADMIN_EMAILS=
